{
  "name": "trekbazaar",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "node server/index.js",
    "seed": "node server/seed.js",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "node --test src/logic.test.ts server/api.test.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "axios": "^1.21.0",
    "express": "^5.3.0",
    "mongoose": "^9.11.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.0"
  },
  "description": "MERN trekking marketplace: browse, wishlist and book Indian treks, plus operator and admin dashboards, backed by an Express + MongoDB API.",
  "engines": {
    "node": ">=22.18"
