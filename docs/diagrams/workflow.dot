digraph G {
  rankdir=TB; bgcolor=white; pad=0.3; nodesep=0.35; ranksep=0.35;
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=10, fillcolor="#eef5ef", color="#2e7d32"];
  edge [fontname="Helvetica", fontsize=9, color="#555555"];
  start [label="Landing / search", shape=oval, fillcolor="#ffffff"];
  explore [label="Explore: filter, sort\nGET /api/treks (on load)"];
  details [label="Trek details: departures with seats left,\napproved reviews, price breakdown"];
  login [label="Log in (trekker account)\nPOST /api/users/login -> token"];
  step1 [label="Step 1: select a scheduled departure"];
  step2 [label="Step 2: participants, traveller and\nsafety details (client validation)"];
  step3 [label="Step 3: review the request\n(no payment is taken)"];
  post [label="POST /api/bookings\nserver checks trek, departure and seats,\nrecomputes amount, saves as Pending"];
  ok [label="Booking requested page\n+ summary download"];
  err [label="Error toast with server message\n(400 / 409, stay on the form)", fillcolor="#fdecea", color="#c62828"];
  opb [label="Operator: confirm or decline\nPATCH /api/bookings/:id"];
  done [label="Operator marks the trip Completed"];
  mine [label="My Bookings: status filters,\ncancel -> PATCH /api/bookings/:id"];
  review [label="Trekker writes a review\nPOST /api/reviews (Pending)"];
  admin [label="Admin approves or rejects\nPATCH /api/reviews/:id"];
  rating [label="Trek rating = average of\napproved reviews", shape=oval, fillcolor="#ffffff"];
  start -> explore -> details -> login -> step1 -> step2 -> step3 -> post;
  post -> ok [label="201"]; post -> err [label="400 / 409"];
  ok -> mine;
  post -> opb [style=dashed, label="appears for the operator"];
  opb -> done [label="Confirmed"];
  done -> review -> admin -> rating;
}
