digraph G {
  rankdir=LR; bgcolor=white; pad=0.3; nodesep=0.5; ranksep=0.7;
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=11, fillcolor="#eef5ef", color="#2e7d32"];
  edge [fontname="Helvetica", fontsize=9, color="#555555"];
  subgraph cluster_client { label="Browser (React 19 + Vite)"; fontname="Helvetica-Bold"; fontsize=11; style="rounded"; color="#999999";
    ui [label="19 screens\n(components, forms)"];
    router [label="react-router-dom\nHashRouter"];
    store [label="StoreProvider\n(Context + hooks)"];
    axios [label="axios client\nsrc/api.ts"];
    ls [label="localStorage\nwishlist, role, theme", fillcolor="#f5f5f5", color="#999999"];
    router -> ui; ui -> store [label="actions"]; store -> ui [label="state"]; store -> axios; store -> ls [style=dashed];
  }
  subgraph cluster_server { label="Node.js + Express 5 (port 4000)"; fontname="Helvetica-Bold"; fontsize=11; style="rounded"; color="#999999";
    mw [label="express.json()\nrequest logger"];
    routes [label="Routers\n/api/treks\n/api/bookings\n/api/users"];
    err [label="404 + error\nhandler"];
    models [label="Mongoose models\nTrek, Booking, User"];
    mw -> routes; routes -> models; routes -> err [style=dashed, label="throw"];
  }
  db [label="MongoDB\ndatabase: trekbazaar", shape=cylinder, fillcolor="#e8f0fb", color="#1f5fbf"];
  axios -> mw [label="HTTP JSON\n(Vite proxy /api)"];
  models -> db [label="queries"];
  db -> models [style=dashed];
  routes -> axios [style=dashed, label="JSON response\n+ status code", constraint=false];
}
