    {
      "name": "Treks",
      "item": [
        {
          "name": "List treks",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/treks",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "treks"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Returns an array\", () => pm.expect(pm.response.json()).to.be.an(\"array\"));",
                  "const trek2 = pm.response.json().find(t => t.id === \"2\");",
                  "pm.test(\"Trek 2 has an open departure\", () => pm.expect(trek2.departures.some(d => d.seatsLeft >= 2)).to.be.true);",
                  "pm.collectionVariables.set(\"departure\", trek2.departures.find(d => d.seatsLeft >= 2).date);"
                ]
              }
            }
          ]
        },
        {
          "name": "Filter treks by state",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/treks?state=Uttarakhand",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "treks"
              ],
              "query": [
                {
                  "key": "state",
                  "value": "Uttarakhand"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"All in Uttarakhand\", () => pm.response.json().forEach(t => pm.expect(t.state).to.eql(\"Uttarakhand\")));"
                ]
              }
            }
          ]
        },
