                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/users/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Tester\",\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"trek1234\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"userId\", pm.response.json().user.id);",
                  "pm.collectionVariables.set(\"registeredToken\", pm.response.json().token);",
                  "pm.test(\"No password hash\", () => pm.expect(pm.response.json().user).to.not.have.property(\"passwordHash\"));"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"testEmail\", `postman.${Date.now()}@example.com`);"
                ]
              }
            }
          ]
        },
        {
          "name": "Register duplicate email",
          "request": {
            "method": "POST",
            "header": [
