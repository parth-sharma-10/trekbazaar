{
  "info": {
    "name": "TrekBazaar API",
    "description": "Run `npm run seed` and `npm run server` first. Requests run top to bottom and pass ids along in collection variables.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4000/api"
    },
    {
      "key": "trekId",
      "value": ""
    },
    {
      "key": "bookingId",
      "value": ""
    },
    {
      "key": "userId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Treks",
      "item": [
        {
          "name": "List treks",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/treks",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "treks"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Returns an array\", () => pm.expect(pm.response.json()).to.be.an(\"array\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Filter treks by state",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/treks?state=Uttarakhand",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "treks"
              ],
              "query": [
                {
                  "key": "state",
                  "value": "Uttarakhand"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"All in Uttarakhand\", () => pm.response.json().forEach(t => pm.expect(t.state).to.eql(\"Uttarakhand\")));"
                ]
              }
            }
          ]
        },
        {
          "name": "Create trek",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/treks",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "treks"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Hampta Pass Trek\",\n  \"location\": \"Kullu Valley\",\n  \"state\": \"Himachal Pradesh\",\n  \"difficulty\": \"Moderate\",\n  \"duration\": \"5 Days\",\n  \"durationDays\": 5,\n  \"price\": 9500,\n  \"maxAltitude\": \"4270m\",\n  \"operator\": \"Himalayan Treks Co.\",\n  \"operatorId\": \"op1\",\n  \"image\": \"https://images.unsplash.com/photo-1626621341517-bbf3d9990a23?w=800\",\n  \"description\": \"Cross from the green Kullu valley into the barren Lahaul desert over a 4,270m pass.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"trekId\", pm.response.json().id);",
                  "pm.test(\"No _id leaked\", () => pm.expect(pm.response.json()).to.not.have.property(\"_id\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get trek",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/treks/{{trekId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "treks",
                "{{trekId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Title matches\", () => pm.expect(pm.response.json().title).to.eql(\"Hampta Pass Trek\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Update trek price",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
