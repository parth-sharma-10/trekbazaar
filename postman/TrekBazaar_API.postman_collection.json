            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Hampta Pass Trek\",\n  \"location\": \"Kullu Valley\",\n  \"state\": \"Himachal Pradesh\",\n  \"difficulty\": \"Moderate\",\n  \"duration\": \"5 Days\",\n  \"durationDays\": 5,\n  \"price\": 9500,\n  \"maxAltitude\": \"4270m\",\n  \"operator\": \"Himalayan Treks Co.\",\n  \"operatorId\": \"op1\",\n  \"image\": \"https://images.unsplash.com/photo-1626621341517-bbf3d9990a23?w=800\",\n  \"description\": \"Cross from the green Kullu valley into the barren Lahaul desert over a 4,270m pass.\"\n}",
