            "body": {
              "mode": "raw",
              "raw": "{\n  \"trekId\": \"2\",\n  \"date\": \"2027-06-12\",\n  \"participants\": 2,\n  \"traveller\": \"Rahul Kumar\",\n  \"email\": \"rahul.kumar@example.com\",\n  \"amount\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
